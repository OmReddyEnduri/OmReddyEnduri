# Relay (set in Render dashboard, never commit real values)
DATABASE_URL=postgresql://user:pass@host/db
BRAIN_API_TOKEN=            # given to the Brain (LLM Arena) only
ADMIN_TOKEN=                # dashboard login + revoke
ENROLL_TOKEN=               # used once per laptop by `laptop_agent init`
# Optional tuning
ONLINE_WINDOW_SECONDS=30
LOST_WINDOW_SECONDS=90
QUEUE_TTL_SECONDS=900
